{
  "name": "@pulp-ui/sdk",
  "version": "0.0.1",
  "license": "Apache-2.0",
  "author": "Pulp",
  "contributors": [
    "Redtigercod4"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "import-schema": "node ./scripts/import-schema.mjs",
    "generate": "orval --config ./orval.config.ts",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "orval": "8.35.0",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "exports": {
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./ansible/*": {
      "types": "./dist/ansible/*.d.ts",
      "default": "./dist/ansible/*.js"
    },
    "./certguard/*": {
      "types": "./dist/certguard/*.d.ts",
      "default": "./dist/certguard/*.js"
    },
    "./deb/*": {
      "types": "./dist/deb/*.d.ts",
      "default": "./dist/deb/*.js"
    },
    "./file/*": {
      "types": "./dist/file/*.d.ts",
      "default": "./dist/file/*.js"
    },
    "./maven/*": {
      "types": "./dist/maven/*.d.ts",
      "default": "./dist/maven/*.js"
    },
    "./npm/*": {
      "types": "./dist/npm/*.d.ts",
      "default": "./dist/npm/*.js"
    },
    "./python/*": {
      "types": "./dist/python/*.d.ts",
      "default": "./dist/python/*.js"
    },
    "./rpm/*": {
      "types": "./dist/rpm/*.d.ts",
      "default": "./dist/rpm/*.js"
    },
    "./pulp-versions.json": "./pulp-versions.json"
  },
  "sideEffects": false
}
